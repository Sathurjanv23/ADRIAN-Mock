# ============================================================
# ADRN Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── MongoDB Atlas ────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nova_db?retryWrites=true&w=majority
MONGODB_DATABASE=nova_db

# ── JWT ──────────────────────────────────────────────────────
# Use a strong random string (minimum 32 characters)
JWT_SECRET=change-me-to-a-strong-random-secret-key-minimum-32-chars

# ── ADRN AI Configuration ────────────────────────────────────
# Options: mock (default for dev) | bedrock (production with AWS)
ADRN_AI_PROVIDER=mock

# ── AWS Bedrock (required only if ADRN_AI_PROVIDER=bedrock) ──
# Use IAM roles in production — avoid long-lived access keys
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# ── Email (Spring Mail) ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# ── Server ───────────────────────────────────────────────────
PORT=8080
